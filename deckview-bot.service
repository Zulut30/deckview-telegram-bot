[Unit]
Description=Deckview Telegram Bot - Hearthstone deck images
After=network.target

[Service]
Type=simple
User=ubuntu
# Подстраховка при пиковой нагрузке (основное исправление — переиспользование HTTP-сессий в коде).
LimitNOFILE=65535
WorkingDirectory=/home/ubuntu/Deckview
ExecStart=/home/ubuntu/Deckview/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/Deckview/.env

[Install]
WantedBy=multi-user.target
