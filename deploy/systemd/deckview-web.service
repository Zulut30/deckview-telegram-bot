[Unit]
Description=Deckview Web API
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/deckview/current
EnvironmentFile=/srv/deckview/shared/.env
Environment=PYTHONUNBUFFERED=1
Environment=DECKVIEW_WEB_PRELOAD_CARDS=1
Environment=DECKVIEW_RENDER_CACHE_WRITE=1
Environment=DECKVIEW_RENDER_CACHE_READ_API=1
Environment=DECKVIEW_RENDER_HOT_CACHE_MAX=1024
Environment=DECKVIEW_RENDER_CACHE_TTL_HOURS=504
ExecStart=/srv/deckview/current/.venv/bin/gunicorn --preload -w 2 -b 127.0.0.1:5000 --timeout 120 --access-logfile - --error-logfile - deckview.web.application:app
Restart=always
RestartSec=5
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
