[Unit]
Description=Refresh Deckview local Kolodahs card snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/deckview/current
EnvironmentFile=/srv/deckview/shared/.env
ExecStart=/srv/deckview/current/.venv/bin/python -m tools.refresh_card_catalog_snapshot
Nice=10
IOSchedulingClass=idle
UMask=0027

[Install]
WantedBy=multi-user.target
