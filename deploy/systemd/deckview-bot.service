[Unit]
Description=Deckview Telegram Bot
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/deckview/current
EnvironmentFile=/srv/deckview/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/deckview/current/.venv/bin/python -m deckview
Restart=always
RestartSec=5
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
