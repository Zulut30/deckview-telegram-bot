TOKEN=YOUR_TOKEN
BATTLE_NET_TOKEN=YOUR_TOKEN
DASHBOARD_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
# Required only for protected publish endpoints.
API_TOKEN=
# Public source archive offered to remote users as required by AGPL section 13.
# Forks must point this to the complete corresponding source of their version.
# DECKVIEW_SOURCE_CODE_URL=https://github.com/Manacost-Labs/Deckview-TG

# Manacost Public API (X-API-Key)
MANACOST_PUBLIC_API_BASE_URL=https://arena.hs-manacost.ru
MANACOST_PUBLIC_API_KEY=
MANACOST_PUBLIC_API_TIMEOUT=20

# Local Telegram Bot API. Keep this local when Deckview runs through telegram-bot-api.
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081

# Updates delivery: polling (rollback) or webhook (local telegram-bot-api -> bot HTTP endpoint).
# DECKVIEW_UPDATE_MODE=polling
# DECKVIEW_WEBHOOK_HOST=127.0.0.1
# DECKVIEW_WEBHOOK_PORT=8792
# DECKVIEW_WEBHOOK_PATH=/deckview/webhook
# DECKVIEW_WEBHOOK_URL=http://127.0.0.1:8792/deckview/webhook
# DECKVIEW_WEBHOOK_SECRET=
# DECKVIEW_WEBHOOK_DROP_PENDING_UPDATES=0
# Reject oversized update bodies before JSON parsing (64 KiB..1 MiB).
# DECKVIEW_WEBHOOK_MAX_BODY_BYTES=262144

# In-process anti-flood protection for Telegram updates. Limits are sliding windows.
# DECKVIEW_FLOOD_PROTECTION=1
# DECKVIEW_RATE_GLOBAL_LIMIT=1000
# DECKVIEW_RATE_GLOBAL_WINDOW=10
# DECKVIEW_RATE_USER_LIMIT=30
# DECKVIEW_RATE_USER_WINDOW=10
# DECKVIEW_RATE_CHAT_LIMIT=120
# DECKVIEW_RATE_CHAT_WINDOW=10
# Expensive deck image requests have a separate budget. The default permits a
# normal burst of several deck codes while RQ still bounds rendering capacity.
# DECKVIEW_RATE_RENDER_LIMIT=12
# DECKVIEW_RATE_RENDER_WINDOW=60
# DECKVIEW_RATE_GLOBAL_RENDER_LIMIT=240
# DECKVIEW_RATE_GLOBAL_RENDER_WINDOW=60
# DECKVIEW_RATE_NOTICE_WINDOW=30
# DECKVIEW_RATE_MAX_KEYS=20000

# Optional Redis/RQ queue for heavy bot jobs.
# DECKVIEW_QUEUE_ENABLED=0
# DECKVIEW_REDIS_URL=redis://127.0.0.1:6379/2
# DECKVIEW_QUEUE_NAME=deckview
# Optional dedicated queue for asynchronous HTTP API renders. When omitted it
# safely shares DECKVIEW_QUEUE_NAME and needs no additional worker.
# DECKVIEW_API_QUEUE_NAME=deckview
# DECKVIEW_QUEUE_JOB_TIMEOUT=300
# Optional shared performance telemetry for Telegram and API render paths.
# DECKVIEW_PERF_LOG=0
# DECKVIEW_PERF_LOG_PATH=cache/deckview_performance.jsonl
# Bit-exact NumPy acceleration for sideboard card tinting.
# DECKVIEW_FAST_PIL=0
# Versioned render cache (504 hours = 21 days). Start write-only.
# DECKVIEW_RENDER_CACHE_WRITE=0
# DECKVIEW_RENDER_CACHE_READ=0
# DECKVIEW_RENDER_CACHE_READ_API=0
# DECKVIEW_RENDER_CACHE_READ_TELEGRAM=0
# DECKVIEW_RENDER_CACHE_TTL_HOURS=504
# DECKVIEW_RENDER_CACHE_ROOT=static/generated/render-cache
# DECKVIEW_RENDERER_VERSION=python-v1
# DECKVIEW_TEMPLATE_VERSION=deckview-2026-08-card-grid-v6
# DECKVIEW_CARD_DATA_VERSION=hsjson-190920

# Optional: publish deck to Telegram channel (ID or @username)
# CHANNEL_ID=-1001234567890
# Optional: different bot token for channel posts
# CHANNEL_BOT_TOKEN=

# Optional: HearthstoneJSON API (import карт по dbfId, билд 190920)
# https://api.hearthstonejson.com/v1/190920/ruRU/
# HSJSON_BUILD=190920
# HSJSON_LOCALE=ruRU
# HSJSON_CARDS_URL=https://api.hearthstonejson.com/v1/190920/ruRU/cards.json

# Optional: WordPress (deck posts)
# WP_BASE_URL=https://yoursite.com
# WP_USER=user
# WP_APP_PASSWORD=xxxx
# WP_UPLOAD_ENABLED=1
# WP_USE_KOLODAHS_IMAGE=1

# Optional: HSGuru streamer deck fetch/parser
# HSGURU_URL=https://www.hsguru.com/streamer-decks
# HSGURU_FALLBACK_URLS=https://api.hsguru.com/
# HSGURU_INTERVAL_SECONDS=1800
# HSGURU_PUBLISH_BATCH_LIMIT=0
# HSGURU_STREAMER_PAGE_LIMIT=100
# HSGURU_STREAMER_OFFSETS=0,50,100,150,200,250
# HSGURU_FETCH_TIMEOUT=30
# HSGURU_FETCH_RETRIES=2
# HSGURU_FETCH_BACKOFF_SECONDS=1.5
# HSGURU_MIN_PARSED_DECKS=20
# HSGURU_STATUS_PATH=cache/hsguru_status.json
# HSGURU_LOCK_PATH=cache/hsguru_fetch.lock
# HSGURU_BROWSER_FALLBACK=1
# HSGURU_BROWSER_PATH=/usr/bin/chromium
# HSGURU_BROWSER_TIMEOUT=35
# HSGURU_PROXY_URLS=socks5h://127.0.0.1:1081,socks5h://127.0.0.1:1082
# HSGURU_CF_CLEARANCE=
# HSGURU_COOKIES=

# Optional: HSGuru archetype recognition API/cache
# HSGURU_ARCHETYPE_API_URL=https://api.hsguru.com/api/deck-info
# HSGURU_ARCHETYPE_CACHE_HOURS=168
# HSGURU_ARCHETYPE_TIMEOUT=20
# HSGURU_ARCHETYPE_BROWSER_FALLBACK=1
# HSGURU_ARCHETYPE_BROWSER_PATH=/usr/bin/chromium

# Deck metadata comes from kolodahs.ru. On the same server, pin its HTTPS
# origin IP to bypass public DNS/CDN while preserving SNI and certificate checks.
# KOLODAHS_CARD_API_LOCAL_IP=151.80.21.140
# KOLODAHS_CARD_API_TIMEOUT=3
# DECKVIEW_BLIZZARD_ATTEMPTS=1
# DECKVIEW_ARCHETYPE_BUDGET_SECONDS=0.35
# Load the shared HSJSON card index once before RQ forks its render workers.
# This moves the cold 1-4 second catalog initialization out of user requests.
# DECKVIEW_WORKER_PRELOAD_CARDS=1
# DECKVIEW_WORKER_PRELOAD_TIMEOUT_SECONDS=5
# With Gunicorn --preload, the site shares the same indexes across web workers.
# DECKVIEW_WEB_PRELOAD_CARDS=1
# MANACOST_PUBLIC_API_ORIGIN_URL=http://127.0.0.1:3101

# Hot-reloadable local card catalog. Refresh it outside the request path with
# `python -m tools.refresh_card_catalog_snapshot` or the supplied systemd timer.
# Missing/corrupt snapshots automatically fall back to SQLite and HTTP.
# DECKVIEW_CARD_SNAPSHOT=0
# DECKVIEW_CARD_SNAPSHOT_PATH=cache/card-catalog/cards-current.json
# Optional absolute cache path for card renders. Defaults to <repo>/cards.
DECKVIEW_CARD_CACHE_DIR=

# Native compositor. Production should enable it; Pillow remains a controlled
# fallback only when DECKVIEW_RUST_REQUIRED is disabled.
# DECKVIEW_RUST_RENDER=0
# DECKVIEW_RUST_THREADS=2
# DECKVIEW_RUST_CARD_CACHE_MAX=256
# Tests/CI only: never hide an unexpected native failure behind Pillow.
# DECKVIEW_RUST_REQUIRED=0
